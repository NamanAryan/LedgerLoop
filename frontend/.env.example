# Copy to .env.local for development. Vite only exposes VITE_-prefixed variables to
# the browser bundle, which is the guardrail that keeps a secret from being shipped
# to every visitor by accident. Nothing here is a secret -- an API base URL is public
# the moment the app makes its first request.
#
# Baked in at BUILD time, not read at runtime: `vite build` substitutes the literal
# string into the bundle. Changing it on the host does nothing until you rebuild,
# which is why the Render static site declares it as a build environment variable.

# Where the FastAPI backend lives.
#   local docker compose -> http://localhost:8000
#   Render               -> https://ledgerloop-api.onrender.com
# No trailing slash; the client strips one anyway rather than emit a double slash
# that some proxies answer with a redirect that drops the CORS headers.
VITE_API_BASE_URL=http://localhost:8000
